# Copy to .env locally or let deploy.sh generate it; never commit real values.
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret
DJANGO_DEBUG=false
# Hostnames/IPs users type in the browser on the local network.
DJANGO_ALLOWED_HOSTS=192.168.1.20
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set these to true only when the site is served over HTTPS.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false

# Start with HSTS disabled; enable it only after HTTPS is confirmed to work.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=true
DJANGO_X_FRAME_OPTIONS=DENY

# Database: postgresql (default) or sqlite (local development only).
DJANGO_DB_ENGINE=postgresql
POSTGRES_DB=target_records
POSTGRES_USER=target_records_app
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# SQLITE_PATH=db.sqlite3

# Optional security tuning (defaults shown).
# DJANGO_SESSION_IDLE_MINUTES=480
# DJANGO_LOGIN_FAILURE_LIMIT=5
# DJANGO_LOGIN_LOCKOUT_MINUTES=15
# DJANGO_MAX_UPLOAD_SIZE_MB=10
