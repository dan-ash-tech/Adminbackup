# Copy to .env locally or set these in deployment; never commit real values.
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# Enable these only when the site is served over HTTPS.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

# Start with HSTS disabled; enable it only after HTTPS is confirmed to work.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=true
DJANGO_X_FRAME_OPTIONS=DENY
